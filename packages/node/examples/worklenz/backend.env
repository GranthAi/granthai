# Worklenz backend settings for the GranthAi example (local demo values only).
# setup.sh copies this to worklenz/worklenz-backend/.env.
NODE_ENV=development
PORT=3000
SESSION_NAME=worklenz.sid
SESSION_SECRET=granthai-example-session-secret
COOKIE_SECRET=granthai-example-cookie-secret
JWT_SECRET=granthai-example-jwt-secret
SERVER_CORS=*
SOCKET_IO_CORS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
HOSTNAME=localhost:5173
LOGIN_FAILURE_REDIRECT=http://localhost:5173/auth/authenticating
LOGIN_SUCCESS_REDIRECT=http://localhost:5173/auth/authenticating
APP_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=55432
DB_USER=postgres
DB_PASSWORD=granthai
DB_NAME=worklenz_db
DB_MAX_CLIENTS=20
USE_PG_NATIVE=false
WORKLENZ_DEPLOYMENT_MODE=self_hosted
STORAGE_PROVIDER=local
ENABLE_EMAIL_CRONJOBS=false
ENABLE_RECURRING_JOBS=false
IMPORT_WORKER_ENABLED=false
TASK_EXPORT_WORKER_ENABLED=false
ENCRYPTION_KEY=granthai-example-encryption-key-32b
ENABLED_ADDONS=
GRANTHAI_BASE_URL=http://localhost:3000
